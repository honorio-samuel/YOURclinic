# API local do fake-api/ (branch feat/api-protegida), com dados sintéticos.
# Para usar outra API sem mexer neste arquivo, crie .env.development.local com
# REACT_APP_API_URL.
REACT_APP_API_URL=http://127.0.0.1:3001

# Botões de acesso de demonstração na tela de login. As contas e a senha são as
# de fake-api/usuarios-de-teste.json e só valem para a API local.
REACT_APP_LOGINS_DEMO=ADMINISTRADOR:admin,MEDICO:medico,SECRETARIA:secretaria,PACIENTE:paciente,RESPONSAVEL_LEGAL:responsavel
REACT_APP_SENHA_DEMO=Demo@2026
